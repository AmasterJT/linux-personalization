@theme "~/.config/rofi/themes/amaster.rasi"

configuration {
    fullscreen: true;
    font: "Noto Sans 11";
    show-icons: true;
    icon-theme: "Win11-Hypervisors";
    click-to-exit: true;
}

window {
    location: center;
    anchor: center;
    width: 100%;
    height: 100%;
    padding: 0px;
    border: 0px;
    border-radius: 0px;
    background-color: rgba(13, 16, 23, 32%);
}

mainbox {
    margin: 40.5% 34.5%;
    padding: 10px;
    border: 3px;
    border-color: @orange;
    border-radius: 14px;
    background-color: rgba(23, 26, 33, 98%);
    spacing: 6px;
}

inputbar {
    padding: 7px 9px;
    border-radius: 8px;
    background-color: rgba(35, 39, 49, 100%);
}

entry {
    background-color: transparent;
    placeholder: "Buscar aplicaciones";
    placeholder-color: rgba(160, 165, 179, 100%);
}

listview {
    border: 0px;
    padding: 2px 0px 0px;
    spacing: 3px;
    background-color: transparent;
}

element {
    padding: 5px 7px;
    border-radius: 7px;
}

element-icon {
    size: 24px;
    margin: 0px 8px 0px 0px;
}

element-text { vertical-align: 0.5; }
